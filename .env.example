# Storage backend: local 또는 s3
PILL_STORAGE_BACKEND=local
PILL_STORAGE_LOCAL_ROOT=artifacts

# S3 backend를 선택할 때 repository 밖에서 실제 값을 설정합니다.
PILL_STORAGE_S3_BUCKET=
PILL_STORAGE_S3_PREFIX=
AWS_PROFILE=
AWS_REGION=
# AWS_REGION 대신 SDK 표준 fallback인 AWS_DEFAULT_REGION도 사용할 수 있습니다.
# AWS_DEFAULT_REGION=
